# Copy to .env for local dev. NEVER commit real secrets.
# Docker Compose reads this file automatically.

# --- App ---
APP_NAME=E-Commerce Backend API
APP_ENV=dev
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (Docker service name = db) ---
DATABASE_URL=postgresql+psycopg2://ecom:ecom@db:5432/ecom
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_DB=ecom
# Host-side ports (internal container ports stay 5432/6379).
# Defaults avoid clashes when several project stacks run on one machine.
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6381

# --- Redis (Docker service name = redis) ---
REDIS_URL=redis://redis:6379/0

# --- Email (M1: console mock; M3: SMTP/SendGrid) ---
EMAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
FRONTEND_URL=http://localhost:3000

# --- Payments (M2: Stripe test mode) ---
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- AWS S3 (M2: product images) ---
AWS_REGION=us-east-1
S3_BUCKET=ecom-product-images-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Rate limiting / lockout ---
FAILED_LOGIN_LIMIT=5
FAILED_LOGIN_WINDOW_MINUTES=10
